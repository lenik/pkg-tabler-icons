--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ tabler-icons/Makefile	2026-01-11 19:29:11.000000000 +0800
@@ -0,0 +1,32 @@
+PREFIX ?= /usr
+DESTDIR ?=
+pkgdatadir ?= $(PREFIX)/share/tabler-icons
+
+all: svg png
+
+svg: icons
+	ln -snf $< $@
+
+svg/filled: svg
+svg/outline: svg
+
+png: png/filled png/outline
+
+png/filled: svg/filled
+	svg2assets -d -o $@ -s 16,20,24,32,48 svg/filled/*.svg
+
+png/outline: svg/outline
+	svg2assets -d -o $@ -s 16,20,24,32,48 svg/outline/*.svg
+
+install: all
+	install -d $(DESTDIR)$(pkgdatadir)/svg/filled
+	install -d $(DESTDIR)$(pkgdatadir)/svg/outline
+	install -d $(DESTDIR)$(pkgdatadir)/png/filled
+	install -d $(DESTDIR)$(pkgdatadir)/png/outline
+	install -m 644 icons/filled/*.svg $(DESTDIR)$(pkgdatadir)/svg/filled/
+	install -m 644 icons/outline/*.svg $(DESTDIR)$(pkgdatadir)/svg/outline/
+	cp -r png/filled $(DESTDIR)$(pkgdatadir)/png/
+	cp -r png/outline $(DESTDIR)$(pkgdatadir)/png/
+	install claude.md $(DESTDIR)$(pkgdatadir)
+
+.PHONY: all svg png install
